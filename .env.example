# Google OAuth client ID for manifest.oauth2.client_id during webpack build.
# Must be a "Chrome Extension" OAuth client created for your extension ID.
GOOGLE_OAUTH_CLIENT_ID=your-extension-client-id.apps.googleusercontent.com

# Required for production builds. Must be the exact HTTPS Worker ingestion route.
TELEMETRY_ENDPOINT=https://telemetry.example.workers.dev/api/telemetry/batches

# Optional until the sharing Worker is deployed. Must be a bare HTTPS origin.
# When set, the recordings page exposes Share and the build grants only this host.
SHARING_SERVICE_ORIGIN=https://sharing.example.workers.dev

# Sharing Worker secrets.
# These are examples only. Generate independent high-entropy values for real environments.
# CAPABILITY_KEYS_JSON is a JSON object keyed by CAPABILITY_KEY_ID (currently "v1").
SESSION_KEY=replace-with-random-session-key
CAPABILITY_KEYS_JSON={"v1":"replace-with-random-capability-v1-key"}
CAPABILITY_KEY=replace-with-random-capability-key
